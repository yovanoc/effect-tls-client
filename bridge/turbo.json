{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "command": ["bun", "../scripts/build-bridge.ts", "--host"],
      "outputs": ["bridge"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-bridge.ts",
        "$TURBO_ROOT$/packages/effect-tls-client/package.json",
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/go.work.sum"
      ]
    },
    "test": {
      "command": ["go", "test", "-race", "./..."]
    }
  }
}
