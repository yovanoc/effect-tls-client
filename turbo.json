{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "experimentalGoWorkspaces": true,
    "experimentalTaskCommand": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "env": ["TLS_CLIENT_BRIDGE_PATH", "TLS_CLIENT_INTEGRATION"]
    },
    "lint": {},
    "format": {},
    "codegen:check": {
      "dependsOn": ["bridge#build"],
      "env": ["TLS_CLIENT_BRIDGE_PATH"],
      "outputs": []
    }
  }
}
