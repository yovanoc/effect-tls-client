{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["bun", "node"],
    "allowImportingTsExtensions": true
  },
  "include": ["scripts/**/*.ts", "oxfmt.config.ts", "oxlint.config.ts"]
}
